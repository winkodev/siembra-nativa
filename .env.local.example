# =============================================
# Supabase - Obtené estos valores en:
# https://supabase.com/dashboard → tu proyecto → Settings → API
# =============================================

NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Service role key - SOLO usar en server-side / Edge Functions. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# =============================================
# App
# =============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deploy hook de Render (Settings del servicio -> Deploy Hook). Lo usa deploy.ps1
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-XXXX?key=XXXX
